# entorno / cache
__pycache__/
*.pyc
.claude/

# repos anidados independientes (cada uno con su propio remoto)
ghl-ofertas-pages/
ghl-planes-pages/

# datos internos de negocio, no van a un repo publico
BaseHoteles_PowerApps.xlsx
EstadoActualDialogos_Arsenal.xlsx

# scripts de exploracion/debug de un solo uso (raiz del proyecto)
/_*.py

# artefactos de scratch
scratchpad_*.txt
debug_*.json

# credenciales de integraciones (no van a git)
quinta_config.py

# reportes_ghl: solo se versiona lo del pipeline de webs individuales,
# no los datos/estado del pipeline corporativo (Pipeline A)
reportes_ghl/*
!reportes_ghl/_individual_bil.json
!reportes_ghl/estado_ofertas_individual.json
!reportes_ghl/ghl_dashboard_individual_latest.html
!reportes_ghl/ghl_dashboard_individual_*.html
# pipeline de PLANES (webs individuales)
!reportes_ghl/_planes_bil.json
!reportes_ghl/estado_planes.json
!reportes_ghl/planes_dashboard_latest.html
!reportes_ghl/planes_dashboard_*.html
reportes_ghl/*_test.html
reportes_ghl/*_test.json
reportes_ghl/_individual_bil_FAILED_*.json
reportes_ghl/_planes_bil_FAILED_*.json
